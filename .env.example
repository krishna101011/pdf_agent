# ============================================================
#  Study Agent settings (optional).
#  Your AI service, model and API keys (up to 5) are set inside the
#  app, on the Settings page. You do NOT need to edit this file for that.
#  Never share or upload ".env".
# ============================================================

# ---- Optional: one API key here instead of the Settings page ----
# (keys saved on the Settings page win over this one)
# Groq keys (console.groq.com) start with gsk_
XAI_API_KEY=
# GROK_BASE_URL=https://api.groq.com/openai/v1
# GROK_MODEL=openai/gpt-oss-120b

# ---- Spending guard rails (these protect your wallet) ---------
# Most steps (think -> use a helper -> think...) one task may take.
MAX_STEPS=8
# Most tokens one task may use (a token is about 3/4 of a word).
MAX_TOKENS_PER_TASK=60000
# Most tokens the agent may use per day, across all tasks. 0 = no daily cap.
DAILY_TOKEN_LIMIT=500000
# Seconds to wait between steps (helps avoid "too many requests" errors).
DELAY_SECONDS=1.0

# ---- Optional helpers -- fill in only the ones you want -------
# GitHub: create a token at https://github.com/settings/tokens
#   (classic token with the "repo" box ticked is the easiest)
GITHUB_TOKEN=

# Vercel: create a token at https://vercel.com/account/tokens
VERCEL_TOKEN=
# Only if you deploy into a team account:
VERCEL_TEAM_ID=

# Email through Gmail:
#   1) turn on 2-step verification in your Google account
#   2) create an "App password" and paste the 16 letters here
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
